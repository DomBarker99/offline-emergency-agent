{
  "name": "offline-emergency-agent",
  "version": "0.0.1",
  "private": true,
  "description": "Offline emergency response agent: answers from a library of official guidance, on-device (SpartHill Hacks 2026).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "app": "electron app/main.ts",
    "chat": "node --env-file-if-exists=.env src/chat.ts",
    "embed": "node --env-file-if-exists=.env src/embed.ts",
    "bench": "node --env-file-if-exists=.env src/bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@openai/agents": "0.21.0",
    "zod": "4.6.7"
  }
}
