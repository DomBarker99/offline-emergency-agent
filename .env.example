# Copy to .env (git-ignored). Read by the desktop app (npm run app), the terminal chat and the benchmark.
# Close the app window and reopen it after changing anything. A line starting with '#' is off.

# ==== REQUIRED: set all three ======================================================================

# 1. Where the model runs while the app is online:
#      local      = a local OpenAI-compatible server at http://127.0.0.1:8080/v1 (works offline)
#      openrouter = Gemma via OpenRouter (needs OPENROUTER_API_KEY)
#    Whenever the app is offline (or "Simulate offline" in demo view), answers come from the local model.
AGENT_PROVIDER=local

# 2. What the window shows:  production = the companion as people would see it
#                            demo       = plus scenario, playback and "Simulate offline" controls
AGENT_VIEW=production

# 3. Which simulated emergency plays:  flood | fire | earthquake | outage | heat
AGENT_SCENARIO=flood

# ==== REQUIRED only when AGENT_PROVIDER=openrouter ================================================
OPENROUTER_API_KEY=

# ==== OPTIONAL =====================================================================================
# Route model calls elsewhere, e.g. through a debugging proxy such as mitmproxy in reverse mode:
# LOCAL_BASE_URL=http://127.0.0.1:8091/v1
# OPENROUTER_BASE_URL=http://127.0.0.1:8090/api/v1
# Open Chromium DevTools next to the window:
# AGENT_DEVTOOLS=1

# ==== Library building only (ignored by the app) ==================================================
# CORPUS_DIR=/path/to/corpus                     # npm run embed reads $CORPUS_DIR/passages.jsonl; Python tools write here
# BUILD_LLM_BASE_URL=https://api.openai.com/v1   # Python tools: any OpenAI-compatible endpoint with structured output
# BUILD_LLM_API_KEY=
# BUILD_LLM_MODEL=gpt-6.1-sol
# BUILD_LLM_REASONING_EFFORT=high
