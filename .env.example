# Copy to ~/.config/sparthill/env on the machine that runs the app (NOT into this repo), then: chmod 600 ~/.config/sparthill/env
# The npm scripts load it automatically with node --env-file-if-exists.

# Required for the OpenRouter provider
OPENROUTER_API_KEY=

# Optional overrides (defaults come from config/models.json)
# LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
