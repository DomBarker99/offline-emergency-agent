# Copy to .env (git-ignored). Edit, then close and reopen the app.

AGENT_PROVIDER=openrouter    # model while online: openrouter or local (offline is always local)
AGENT_SCENARIO=flood         # the emergency it opens on: flood, fire, earthquake, outage, heat
AGENT_LOCAL_MODEL=gemma4-26b-a4b   # the model on this laptop: gemma4-26b-a4b or granite4.2-8b
OPENROUTER_API_KEY=          # needed only for openrouter

# In the window: Ctrl+Shift+O = pretend the internet is gone, press again to come back.
# Turning Wi-Fi off does the same for real.
# Something wrong? The app logs to the terminal running `npm run app`. Every answer with its full
# prompt: logs/turns-<date>.jsonl.

# Optional (remove the # to turn on):
# AGENT_DEVTOOLS=1                                   # Chromium DevTools next to the window
# LOCAL_BASE_URL=http://127.0.0.1:8091/v1            # route local model calls elsewhere (e.g. mitmproxy)
# OPENROUTER_BASE_URL=http://127.0.0.1:8090/api/v1   # route OpenRouter calls elsewhere (e.g. mitmproxy)

# Library building only (the app ignores these):
# CORPUS_DIR=/path/to/corpus                     # npm run embed reads $CORPUS_DIR/passages.jsonl; Python tools write here
# BUILD_LLM_BASE_URL=https://api.openai.com/v1   # Python tools: any OpenAI-compatible endpoint with structured output
# BUILD_LLM_API_KEY=
# BUILD_LLM_MODEL=gpt-6.1-sol
# BUILD_LLM_REASONING_EFFORT=high
