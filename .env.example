# Copy to .env (git-ignored). Loaded automatically by the npm scripts and by `uv run --env-file ../.env`.

# Required for the OpenRouter provider
OPENROUTER_API_KEY=

# Optional endpoint overrides (defaults in config/models.json)
# LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: where audit logs are written (default: ./logs)
# LOG_DIR=./logs

# Knowledge backend: demo (6 placeholder cards, default) or cognee (official library; run `npm run knowledge` first)
# KNOWLEDGE_BACKEND=cognee
# KNOWLEDGE_URL=http://127.0.0.1:8788
# (pack for `npm run knowledge`: set KNOWLEDGE_PACK in your shell, relative to knowledge/, default ../data/pack/library-v1)
# CARDS_FILE=data/cards/library-cards.json
# KNOWLEDGE_MODE=hybrid                       # hybrid | vector | lexical | graph (for comparisons)

# Library building (knowledge/*.py, online only)
# CORPUS_DIR=/path/to/corpus                  # where collect.py writes captures and passages
# BUILD_LLM_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint with structured output
# BUILD_LLM_API_KEY=
# BUILD_LLM_MODEL=gpt-6.1-sol
# BUILD_LLM_REASONING_EFFORT=high
