# Copy to .env (git-ignored). Read automatically by the npm scripts.

# Needed for --provider openrouter
OPENROUTER_API_KEY=

# Which model the app and chat use. Keep exactly ONE block active (without '#').
# -- Local model server (offline) --
AGENT_PROVIDER=local
# -- OpenRouter (needs OPENROUTER_API_KEY) --
# AGENT_PROVIDER=openrouter
# -- Optional: route model calls through a debugging proxy (example: mitmproxy in reverse mode) --
# LOCAL_BASE_URL=http://127.0.0.1:8091/v1
# OPENROUTER_BASE_URL=http://127.0.0.1:8090/api/v1
# -- Optional: open DevTools next to the app window --
# AGENT_DEVTOOLS=1

# Library building only
# CORPUS_DIR=/path/to/corpus                     # npm run embed reads $CORPUS_DIR/passages.jsonl; Python tools write here
# BUILD_LLM_BASE_URL=https://api.openai.com/v1   # Python tools: any OpenAI-compatible endpoint with structured output
# BUILD_LLM_API_KEY=
# BUILD_LLM_MODEL=gpt-6.1-sol
# BUILD_LLM_REASONING_EFFORT=high
